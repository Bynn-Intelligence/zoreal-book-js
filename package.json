{
  "name": "@zoreal/book-js",
  "version": "0.1.1",
  "description": "ZOREAL Book embed for the browser, framework-free: your booking page inside your own site, in an iframe neither page can read.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bynn-Intelligence/zoreal-book-js.git"
  },
  "homepage": "https://zoreal.com",
  "keywords": [
    "zoreal",
    "book",
    "booking",
    "scheduling",
    "appointments",
    "calendar",
    "embed",
    "iframe"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/embed.js"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^28.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
